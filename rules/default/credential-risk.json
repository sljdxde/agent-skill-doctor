{
  "version": 1,
  "rules": [
    {
      "id": "credential-risk",
      "title": "Possible credential access",
      "severity": "medium",
      "category": "credential",
      "patterns": [
        { "id": "env-file-read", "regex": "\\b(?:cat|source|readfile(?:sync)?|load_dotenv|dotenv)\\b[^\\n]{0,80}\\.env\\b" },
        { "id": "ssh-directory-read", "regex": "\\b(?:cat|find|ls|readfile(?:sync)?|scandir)\\b[^\\n]{0,80}~\\/.ssh\\b" }
      ],
      "recommendation": "Require explicit user review before enabling skills that reference credential locations or secret names."
    }
  ]
}
